<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Click to Greet</title>
</head>
<body>
  <button type="button" id="greetButton">Click to Greet</button>

  <script>
    document.getElementById('greetButton').addEventListener('click', function () {
      alert('Hello, World!');
    });
  </script>
</body>
</html>